# ==========================================
# ROOT .gitignore - General patterns for ALL projects
# ==========================================

# Python/Virtual Environments (matches ANY venv)
venv*/
venv_*/
.venv/
.env
.venv
.Python

# Python cache (anywhere)
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Database files
*.sqlite3
*.db
*.sql

# Logs
*.log
logs/
*.pid

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# System files
*.service
/tmp/

# Project-specific generated files
clean_schema.sql
schema.sql

# Backup files (any .backup anywhere)
*.backup
*.backup*
