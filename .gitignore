cd ~/db-apps
cat > .gitignore << 'EOF'
# Python
venv*/
venv_*/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.env
.venv

# Database
*.sqlite3
*.db

# Logs
*.log
logs/
*.pid

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# System
*.service
/tmp/

# Project specific
clean_schema.sql
schema.sql
EOF

# Project-specific ignores
# 01 - Servers Manager
01/venv_01/
01/.env
01/__pycache__/
01/*.backup*

# 02 - Task Tracker
02/venv_02/
02/.env
02/__pycache__/
02/*.backup*
